APP_NAME=relatorio-de-desempenho
BASE_URL=http://localhost:3456
DATA_DIR=./data
CORS_ORIGINS=*

# Optional integrations
GITHUB_TOKEN=

# Optional LLM configuration
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=

# SMTP configuration (email notifications, used as fallback if Azure/Graph vars below are empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Microsoft Graph API (Azure AD app, client credentials flow) - takes priority over SMTP when filled in
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=